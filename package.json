{
    "name": "strapi-plugin-request-schema",
    "version": "1.1.1",
    "description": "A Strapi plugin that allows to create schemas that the request must follow.",
    "strapi": {
        "kind": "plugin",
        "name": "strapi-plugin-request-schema",
        "displayName": "Request Schema",
        "description": "A Strapi plugin that allows to create schemas that the request must follow."
    },
    "author": {
        "name": "Bruno RightCO",
        "email": "bruno.ascencao@ntweb.pt"
    },
    "keywords": ["strapi", "plugin"],
    "type": "commonjs",
    "exports": {
        "./package.json": "./package.json",
        "./strapi-server": {
            "source": "./server/src/index.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "strapi-plugin build",
        "watch": "strapi-plugin watch",
        "watch:link": "strapi-plugin watch:link"
    },
    "dependencies": {
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@strapi/sdk-plugin": "^5.3.2",
        "@strapi/strapi": "^5.23.0",
        "@strapi/typescript-utils": "^5.23.0",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "@strapi/strapi": "^5.23.0"
    },
    "license": "MIT"
}
